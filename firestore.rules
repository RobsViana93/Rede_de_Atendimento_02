rules_version = '2';

// =====================================================
// Regras de segurança do Firestore — Rede de Atendimento
// Publique com:  firebase deploy --only firestore:rules
// =====================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // Administradores atuais usam contas provisionadas com email/senha.
    // Exclui contas anônimas e outros provedores, sem leituras extras nas regras.
    function administrador() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function estabelecimentoValido(d) {
      return d.keys().hasAll(['nome', 'estado', 'cidade', 'tipo', 'operadoras'])
        && d.keys().hasOnly(['nome', 'estado', 'cidade', 'tipo', 'operadoras', 'modalidades', 'planos'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 300
        && d.cidade is string && d.cidade.size() > 0 && d.cidade.size() <= 300
        && d.estado in ['AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI', 'RJ', 'RN', 'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO']
        && d.tipo in ['hospital', 'clinica', 'laboratorio']
        && d.operadoras is list && d.operadoras.size() > 0 && d.operadoras.size() <= 6
        && d.operadoras.hasOnly(['amil', 'amil-selecionada', 'bradesco', 'sulamerica', 'hapvida', 'liv-saude'])
        && d.get('modalidades', '') is string && d.get('modalidades', '').size() <= 10000
        && d.get('planos', '') is string && d.get('planos', '').size() <= 10000;
    }

    // Coleta de estabelecimentos da rede credenciada
    match /hospitais/{docId} {

      // LEITURA: pública (a página de pesquisa é aberta a clientes).
      allow read: if true;

      // ESCRITA: apenas usuários autenticados via Firebase Auth
      // (email/senha cadastrados no painel Authentication).
      // COM A REGRA ABAIXO ATIVA, o site público NÃO conseguirá ler
      // se você remover o `allow read`. Teste antes de endurecer.
      allow create, update: if administrador() && estabelecimentoValido(request.resource.data);
      // Registros legados continuam podendo ser excluídos.
      allow delete: if administrador();
    }

    // Qualquer outra coleção: negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
